# Copy this file to .env (git-ignored) and fill in real local values.
# Never commit the real .env file. See DECISIONS.md D010.

# OpenObserve (Phase 0 dependency; see docs/phase0-networking.md)
OPENOBSERVE_URL=http://<resolved-at-setup>:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USERNAME=admin@example.com
OPENOBSERVE_PASSWORD=<your-local-password>

# Traffic generator defaults (Phase 2 CLI flags override these)
TRAFFIC_USERS=1
TRAFFIC_RATE=2

# Kubernetes namespace used throughout
K8S_NAMESPACE=payasam
